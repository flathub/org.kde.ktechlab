                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/frameworks/5.116/portingAids/kjs-5.116.0.tar.xz",
                    "sha256": "9fb4f33e31d5b31eb6449311c1c61acaa968d42419252c0ab9dccb1f5fd9e1b7",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 379839,
                        "stable-only": true,
